[sub_resource type="Shader" id="Shader_wtcfe"]
code = "shader_type canvas_item;

uniform sampler2D screen_tex : hint_screen_texture;

uniform vec4 color_a : source_color = vec4(0.0, 0.0, 0.0, 1.0); // Color oscuro
uniform vec4 color_b : source_color = vec4(1.0, 1.0, 1.0, 1.0); // Color claro
uniform float threshold : hint_range(0.0, 1.0) = 0.5;
uniform float dither_strength : hint_range(0.0, 0.02) = 0.004; // 0 = sin dither

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}

void fragment() {
	// Color original de pantalla
	vec3 col = texture(screen_tex, SCREEN_UV).rgb;

	// Luminancia (brillo percibido)
	float lum = dot(col, vec3(0.2126, 0.7152, 0.0722));

	// Dither opcional: SOLO afecta dónde cae el umbral, pero el resultado sigue siendo 2 colores
	if (dither_strength > 0.0) {
		float n = hash(FRAGCOORD.xy) - 0.5; // -0.5..0.5
		lum += n * dither_strength;
	}

	// Decisión binaria: 0 o 1
	float m = step(threshold, lum);

	// Salida final: estrictamente 2 colores
	COLOR = mix(color_a, color_b, m);
}
"

